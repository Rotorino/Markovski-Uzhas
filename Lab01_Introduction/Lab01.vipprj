<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<projectData-map description="Лабораторная работа 1" final_directory="Exe" debug_directory="Deb" intermediate_directory="Obj" pattern="Console application" rules="Console" version="6">
  <include_directory-list>
    <include_directory>.</include_directory>
    <include_directory>$(ProDir)</include_directory>
  </include_directory-list>
  <item-set key="filename">
    <item-map filename="$(ProDir)Lib\vipInit.lib" />
    <item-map filename="$(ProDir)Lib\vipKernel.lib" />
    <item-map filename="$(ProDir)Lib\vipRun.lib" />
    <item-map filename="$(ProDir)Lib\win32.lib" />
    <item-map filename="main.version" />
    <item-map filename="main.manifest" />
    <item-map filename="main.pack" />
    <item-map filename="ProjectIcon.ico" resource_id="application_icon" />
  </item-set>
  <setting-set key="target">
    <setting-map target="Win32">
      <var-list>
        <var-map name="Target.Machine" value="x86" />
      </var-list>
    </setting-map>
  </setting-set>
</projectData-map>

